import { Styles } from "../widgets/styles.slint";
import { AdqaBridge } from "../blocks/bridges.slint";
import { Button } from "../widgets/button.slint";
import { UiState } from "../blocks/globals.slint";

export component AdvisoryPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: Styles.sizes.p-xl * 2;
        spacing: Styles.sizes.s-lg;

        HorizontalLayout {
            spacing: Styles.sizes.s-md;
            Text {
                text: "Advisory Results";
                font-size: Styles.sizes.font * 1.3;
                font-weight: 700;
                color: Styles.palette.window-fg;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Button {
                text: "Run Analysis";
                icon: @image-url("../assets/send.svg");
                icon-color: Styles.palette.success-bg;
                clicked => {
                    AdqaBridge.run-analysis();
                }
            }

            // Progress indicator
            if AdqaBridge.status == "running": Text {
                text: "Running... " + round(AdqaBridge.progress * 100) + "%";
                color: Styles.palette.info-bg;
                vertical-alignment: center;
            }

            if AdqaBridge.status == "done": Text {
                text: "Done ✓";
                color: Styles.palette.success-bg;
                vertical-alignment: center;
            }

            if AdqaBridge.status == "error": Text {
                text: "Error ✗";
                color: Styles.palette.error-bg;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: Styles.palette.layer-3; }

        // Status message
        if AdqaBridge.status-message != "": Text {
            text: AdqaBridge.status-message;
            color: Styles.palette.window-fg;
            opacity: 0.7;
            font-size: Styles.sizes.font * 0.9;
        }

        Rectangle { height: 1px; background: Styles.palette.layer-3; }

        // Summary
        Text {
            text: "Summary:";
            color: Styles.palette.window-fg;
            font-weight: 600;
        }

        summary-area := Rectangle {
            background: Styles.palette.layer-1;
            border-radius: Styles.sizes.r-md;
            vertical-stretch: 1;
            horizontal-stretch: 1;
            min-height: 120px;
            clip: true;

            Flickable {
                VerticalLayout {
                    padding: Styles.sizes.p-md;
                    spacing: Styles.sizes.s-sm;

                    Text {
                        text: AdqaBridge.result-summary == "" ? "No summary yet. Run an analysis from the Data tab." : AdqaBridge.result-summary;
                        font-family: "Reverier Mono";
                        font-size: Styles.sizes.font * 0.8;
                        color: AdqaBridge.result-summary == "" ? Styles.palette.window-alter-fg : Styles.palette.window-fg;
                        wrap: TextWrap.word-wrap;
                        width: summary-area.width - Styles.sizes.p-md * 2;
                    }
                }
            }
        }
    }
}
